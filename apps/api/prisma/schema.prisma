generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  pending
  active
  rejected
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(user)
  status       UserStatus @default(pending)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  entries      DiaryEntry[]

  @@map("users")
}

model StockCatalog {
  code      String   @id @db.VarChar(16)
  name      String   @db.VarChar(64)
  market    String   @db.VarChar(8)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name], map: "idx_stock_catalog_name")
  @@map("stock_catalog")
}

model DiaryEntry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String   @db.VarChar(200)
  entryDate      DateTime @map("entry_date") @db.Date
  pnlDay         Decimal? @map("pnl_day") @db.Decimal(12, 2)
  pnlTotal       Decimal? @map("pnl_total") @db.Decimal(12, 2)
  mood           String?  @db.VarChar(20)
  marketSnapshot Json?    @map("market_snapshot")
  content        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks         DiaryStock[]

  @@index([userId, entryDate(sort: Desc)], map: "idx_diary_entries_user_date")
  @@map("diary_entries")
}

model DiaryStock {
  id      String     @id @default(uuid()) @db.Uuid
  entryId String     @map("entry_id") @db.Uuid
  code    String     @db.VarChar(16)
  name    String     @db.VarChar(64)
  entry   DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId], map: "idx_diary_stocks_entry")
  @@index([code], map: "idx_diary_stocks_code")
  @@map("diary_stocks")
}
