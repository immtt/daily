// 本地开发默认：SQLite（单文件，无需单独起数据库进程）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  pending
  active
  rejected
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(user)
  status       UserStatus @default(pending)
  /// 是否启用生活栏目二次密码
  lifeAccessEnabled Boolean  @default(false) @map("life_access_enabled")
  lifePasswordHash  String?  @map("life_password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  entries      DiaryEntry[]

  @@map("users")
}

model StockCatalog {
  code      String   @id
  name      String
  market    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name], map: "idx_stock_catalog_name")
  @@map("stock_catalog")
}

model DiaryEntry {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  title          String
  entryDate      DateTime  @map("entry_date")
  /// stock=股票 reading=读书 life=生活
  domain         String    @default("stock")
  /// review=复盘 mindset=心法（仅 stock）
  category       String    @default("review")
  /// 读书/生活子标签 slug
  tag            String?
  pinned         Boolean   @default(false)
  pinnedAt       DateTime? @map("pinned_at")
  /// 标题+正文纯文本，供心法关键字搜索
  searchText     String    @default("") @map("search_text")
  pnlDay         Decimal?  @map("pnl_day")
  pnlTotal       Decimal?  @map("pnl_total")
  mood           String?
  /// 情绪值 0-100，stock/life 可选
  moodScore      Int?      @map("mood_score")
  /// life 域可选位置 { lat, lng, label?, capturedAt? }
  location       Json?
  marketSnapshot Json?     @map("market_snapshot")
  content        Json
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks         DiaryStock[]
  books          DiaryBook[]

  @@index([userId, entryDate], map: "idx_diary_entries_user_date")
  @@index([userId, deletedAt], map: "idx_diary_entries_user_trash")
  @@index([userId, category], map: "idx_diary_entries_user_category")
  @@index([userId, domain], map: "idx_diary_entries_user_domain")
  @@index([userId, domain, tag], map: "idx_diary_entries_user_domain_tag")
  @@index([userId, pinned, pinnedAt], map: "idx_diary_entries_user_pinned")
  @@map("diary_entries")
}

model DiaryStock {
  id      String     @id @default(uuid())
  entryId String     @map("entry_id")
  code    String
  name    String
  entry   DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId], map: "idx_diary_stocks_entry")
  @@index([code], map: "idx_diary_stocks_code")
  @@map("diary_stocks")
}

model DiaryBook {
  id      String     @id @default(uuid())
  entryId String     @map("entry_id")
  title   String
  entry   DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId], map: "idx_diary_books_entry")
  @@index([title], map: "idx_diary_books_title")
  @@map("diary_books")
}

/// 大盘每日收盘快照（仅完整收盘可入库；盘中数据不入库）
model MarketDailySnapshot {
  tradeDate     String   @id @map("trade_date")
  snapshotKind  String   @map("snapshot_kind")
  isComplete    Boolean  @default(false) @map("is_complete")
  indices       Json
  breadthRise   Int      @map("breadth_rise")
  breadthFall   Int      @map("breadth_fall")
  turnover      Decimal
  capitalInflow Decimal  @map("capital_inflow")
  source        String?
  capturedAt    DateTime @map("captured_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([tradeDate(sort: Desc), isComplete], map: "idx_market_snapshots_date_complete")
  @@map("market_daily_snapshots")
}
