# 本地开发：SQLite（单文件，路径相对 prisma/schema.prisma）
DATABASE_URL="file:../../../data/stock-diary.db"

# 生产 / Docker 请改用 PostgreSQL，见 schema.postgresql.prisma
# DATABASE_URL=postgresql://stock:stock_secret@localhost:5432/stock_diary?schema=public

# JWT（生产环境请改为 ≥32 位随机串）
JWT_SECRET=change-me-to-a-long-random-secret-key-32+

# 种子管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# 首版关闭公开注册
OPEN_REGISTRATION=false

# API
API_PORT=3000
UPLOAD_DIR=./uploads

# 前端开发代理目标
VITE_API_BASE=
